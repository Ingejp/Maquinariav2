APP_NAME=Maquinaria
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Producción/staging: MySQL sobre la instancia AWS RDS existente.
# Desarrollo local sin acceso a RDS: dejar DB_CONNECTION=sqlite (ver .env local).
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# En RDS, obligar TLS en la conexión (ver hallazgo A04 OWASP del análisis técnico).
MYSQL_ATTR_SSL_CA=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción (servida por HTTPS), forzar cookies solo-HTTPS.
# Dejar comentado en local (php artisan serve sirve por HTTP y la sesión no
# funcionaría con esta bandera en true).
# SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# Usados solo por database/seeders/AdminUserSeeder.php para crear el primer
# Super Admin. Si no se define ADMIN_PASSWORD, se genera una aleatoria y se
# imprime una única vez en consola (ver hallazgo 6.3 del análisis técnico:
# no hardcodear un hash fijo de admin en el código versionado).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
